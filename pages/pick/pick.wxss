.empty { text-align: center; padding: 100rpx 40rpx; }
.refresh { margin-top: 30rpx; width: 320rpx; }
.worry { border-left: 10rpx solid #ffb5c2; }
.who { font-size: 26rpx; color: #ff7d9c; font-weight: 700; }
.content { font-size: 30rpx; line-height: 1.7; margin-top: 14rpx; }
.chips { margin-top: 16rpx; }
.chip { display: inline-block; background: #eef7f0; border-radius: 999rpx; padding: 6rpx 20rpx; font-size: 24rpx; color: #3d8a5f; }
.title { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.ta {
  width: 100%; height: 200rpx; border: 2rpx dashed #cfe3d5; border-radius: 20rpx;
  padding: 20rpx; font-size: 28rpx; background: #fbfefc; box-sizing: border-box;
}
.stickers { display: flex; gap: 14rpx; margin-top: 16rpx; }
.sticker { font-size: 40rpx; background: #f2f9f4; border-radius: 18rpx; padding: 12rpx 16rpx; }
.sticker:active { background: #dcefe3; }
.foot { display: flex; gap: 20rpx; margin-top: 20rpx; }
.send { flex: 1.3; } .ghost { flex: 1; background: #fff; color: #3d8a5f; border: 2rpx solid #5cae7f; box-shadow: none; }
