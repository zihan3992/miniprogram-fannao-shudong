.title { font-size: 34rpx; font-weight: 700; margin-bottom: 6rpx; }
.label { margin-bottom: 14rpx; }
.row { display: flex; gap: 18rpx; }
.row.wrap { flex-wrap: wrap; }
.sticker {
  font-size: 44rpx; background: #f2f9f4; border-radius: 20rpx;
  padding: 12rpx 18rpx; border: 3rpx solid transparent;
}
.sticker.on { background: #dcefe3; border-color: #5cae7f; transform: scale(1.1); }
.chip {
  background: #eef7f0; border-radius: 999rpx; padding: 10rpx 24rpx;
  font-size: 26rpx; color: #3d8a5f; border: 3rpx solid transparent;
}
.chip.on { background: #5cae7f; color: #fff; }
.ta {
  width: 100%; height: 220rpx; border: 2rpx dashed #cfe3d5;
  border-radius: 20rpx; padding: 20rpx; font-size: 28rpx; background: #fbfefc;
  box-sizing: border-box;
}
.foot { margin-top: 16rpx; display: flex; align-items: center; gap: 20rpx; }
.submit { width: 260rpx; }
