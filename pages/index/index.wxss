.head { display: flex; align-items: center; gap: 16rpx; }
.head text { font-size: 48rpx; }
.head-title { font-weight: 700; font-size: 32rpx; }

.tree-wrap {
  position: relative; height: 900rpx; margin: 20rpx 24rpx;
  border-radius: 32rpx; overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(61,79,66,.14);
}
.scene { position: absolute; inset: 0; width: 100%; height: 100%; }
.bug {
  position: absolute; font-size: 52rpx;
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,.2);
}
.b1 { left: 18%; top: 30%; }
.b2 { right: 16%; top: 42%; }
.b3 { left: 40%; top: 24%; }
.wiggle { animation: wiggle 2.4s ease-in-out infinite; }
@keyframes wiggle {
  0%,100% { transform: rotate(0) scale(1); }
  25% { transform: rotate(-10deg) scale(1.06); }
  75% { transform: rotate(10deg) scale(1.06); }
}
.fruit-badge {
  position: absolute; top: 20rpx; left: 20rpx;
  background: rgba(255,255,255,.92); border-radius: 999rpx;
  padding: 8rpx 22rpx; font-size: 26rpx; font-weight: 700; color: #b06a00;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.12);
}
.plaque {
  position: absolute; bottom: 18rpx; left: 50%; transform: translateX(-50%);
  background: rgba(101,84,63,.88); color: #fff; font-size: 20rpx;
  padding: 8rpx 22rpx; border-radius: 999rpx; white-space: nowrap;
}
.actions { display: flex; gap: 20rpx; margin: 10rpx 40rpx; }
.actions .go { flex: 1.4; }
.actions .ghost { flex: 1; background: #fff; color: #3d8a5f; border: 2rpx solid #5cae7f; box-shadow: none; }
.tip { padding: 20rpx 28rpx; }
.tip-line { font-size: 24rpx; color: #7c9484; line-height: 1.9; }
