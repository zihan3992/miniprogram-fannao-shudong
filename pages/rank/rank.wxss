.head { text-align: center; }
.tabs { margin-top: 14rpx; display: flex; justify-content: center; gap: 14rpx; }
.tab { background: #eef7f0; border-radius: 999rpx; padding: 8rpx 28rpx; font-size: 26rpx; color: #7c9484; }
.tab.on { background: #5cae7f; color: #fff; font-weight: 700; }
.rank-row {
  display: flex; align-items: center; gap: 16rpx; background: #fff;
  border-radius: 20rpx; padding: 20rpx 24rpx; margin: 14rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(61,79,66,.06);
}
.rank-row.top3 { border: 2rpx solid #ffcf6e; background: #fffdf5; }
.medal { font-size: 36rpx; width: 60rpx; text-align: center; }
.avatar {
  width: 76rpx; height: 76rpx; border-radius: 50%; background: #eef7f0;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.info { flex: 1; }
.name { font-weight: 700; }
.badge {
  font-size: 20rpx; background: #e8f5ec; color: #3d8a5f;
  border-radius: 10rpx; padding: 4rpx 10rpx; margin-left: 10rpx;
}
.count { background: #ffcf6e; color: #8a5a00; border-radius: 999rpx; padding: 6rpx 20rpx; font-weight: 700; font-size: 26rpx; }
.empty { text-align: center; padding: 60rpx; }
.tip .title { font-weight: 700; margin-bottom: 6rpx; }
