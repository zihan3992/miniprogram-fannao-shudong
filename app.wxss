page {
  background: #eaf6ef;
  color: #3d4f42;
  font-size: 28rpx;
}
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(61, 79, 66, 0.08);
}
.btn-green {
  background: #5cae7f;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.btn-green::after { border: none; }
.muted { color: #7c9484; font-size: 24rpx; }
